upstream frontend_upstream {
  server frontend:3000;
  keepalive 32;
}

upstream backend_upstream {
  server backend:8000;
  keepalive 32;
}

server {
  listen 8080 default_server;
  server_name _;

  # Nginx's request-level error text includes full URLs and headers. Query-free
  # JSON access records carry failure status, upstream status, timing and ID;
  # application exceptions retain safe locations in structured server logs.
  # Startup/configuration diagnostics remain enabled in nginx.conf.
  error_log /dev/null;

  # Only this network may supply X-Forwarded-For. With recursion enabled,
  # Nginx selects the last non-trusted address and then replaces the upstream
  # header with that one canonical client identity.
  set_real_ip_from ${NGINX_TRUSTED_PROXY_CIDR};
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;

  client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};
  limit_req_status 429;
  limit_req_log_level warn;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy $neb_referrer_policy always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  # Browsers ignore HSTS received over plain HTTP. Keep this at zero locally;
  # production raises it in stages only after HTTPS is verified end to end.
  proxy_hide_header Strict-Transport-Security;
  add_header Strict-Transport-Security "max-age=${NGINX_HSTS_SECONDS}" always;

  error_page 502 503 504 /service-unavailable.html;

  location = /service-unavailable.html {
    internal;
    error_log /dev/null;
    root /usr/share/nginx/html;
    # Location headers replace inherited ones on stable Nginx releases.
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=${NGINX_HSTS_SECONDS}" always;
    add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'" always;
  }

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location = /api/health {
    access_log off;
    proxy_pass http://frontend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto ${NGINX_FORWARDED_PROTO};
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 10s;
  }

  location ~ ^/api/v1/auth/(login|register|verify-email|resend-verification|password-reset(?:/confirm)?|email-change(?:/confirm)?)/?$ {
    limit_req zone=auth_limit burst=${NGINX_AUTH_BURST} nodelay;
    proxy_pass http://backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto ${NGINX_FORWARDED_PROTO};
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
  }

  location /api/ {
    limit_req zone=api_limit burst=60 nodelay;
    proxy_pass http://backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto ${NGINX_FORWARDED_PROTO};
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
  }

  location = /admin/login/ {
    allow ${NGINX_ADMIN_ALLOW_CIDR};
    deny all;
    limit_req zone=auth_limit burst=${NGINX_AUTH_BURST} nodelay;
    proxy_pass http://backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto ${NGINX_FORWARDED_PROTO};
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
  }

  location /admin/ {
    allow ${NGINX_ADMIN_ALLOW_CIDR};
    deny all;
    proxy_pass http://backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto ${NGINX_FORWARDED_PROTO};
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
  }

  location /static/ {
    proxy_pass http://backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto ${NGINX_FORWARDED_PROTO};
    proxy_set_header Connection "";
    expires 1h;
  }

  # Retain assets from earlier releases for open tabs and frontend rollback.
  # An absent archive (local development) falls through to the active frontend.
  location ^~ /_next/static/ {
    root /srv/frontend-assets/public;
    disable_symlinks on;
    try_files $uri @frontend_static;
    # Location headers replace inherited ones on stable Nginx releases.
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy $neb_referrer_policy always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=${NGINX_HSTS_SECONDS}" always;
  }

  location @frontend_static {
    proxy_pass http://frontend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto ${NGINX_FORWARDED_PROTO};
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 120s;
  }

  location / {
    proxy_pass http://frontend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto ${NGINX_FORWARDED_PROTO};
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_connect_timeout 5s;
    proxy_read_timeout 120s;
  }
}
